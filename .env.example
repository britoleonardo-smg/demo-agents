# Qual provedor de LLM os agentes usam: openai ou gemini
LLM_PROVIDER=openai

# Opcional: troca o modelo (padrão: gpt-5-nano para openai, gemini-3.8-flash para gemini)
# LLM_MODEL=gpt-5-nano

# Só a chave do provedor escolhido é obrigatória
OPENAI_API_KEY=your-key-here-from-https://platform.openai.com/api-keys
GEMINI_API_KEY=your-key-here-from-https://aistudio.google.com/apikey

# Opcional: tracing dos estágios 02 e 03 no LangSmith (https://smith.langchain.com).
# Sem isto os agentes rodam igual — só não aparecem lá.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=agentes-demo
